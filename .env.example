# LLM provider — "openai" (default) or "anthropic"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...   # required if LLM_PROVIDER=anthropic

# Embeddings — Voyage AI only (voyage-law-2 is fixed)
VOYAGE_API_KEY=pa-...

# Auth
JWT_SECRET=replace-with-strong-random-secret-at-least-32-chars

# PostgreSQL (matches docker-compose defaults)
DATABASE_URL=postgresql://admin:password@localhost:5433/pharmanet

# Optional: auto-admin accounts (JSON array of emails or usernames)
ADMIN_EMAILS=["admin@example.com"]

# Rate limiting
ASK_RATE_LIMIT=20/minute

# Reranker model (HuggingFace cross-encoder)
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Legal cross-reference pre-fetch
ENABLE_CROSSREF_RESOLUTION=true
CROSSREF_MAX_REFS=3

# Collection names (override if your data uses different names)
LEGAL_COLLECTION_NAME=legal
DRUG_COLLECTION_NAME=drug

# Retrieval speed knobs (uncomment to override defaults)
# HYBRID_TOP_K=15
# RERANK_INPUT_K=15
# DENSE_MULTI_QUERY_K=1
# QUERY_EXPANSION_COUNT=2
